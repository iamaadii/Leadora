# ==============================================================================
# Leadora CRM — Production & Development Environment Configuration (.env)
# ==============================================================================

# Application environment ('development' | 'test' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Docker Compose & Production Database)
# ------------------------------------------------------------------------------
DB_USER=crm_admin
DB_PASSWORD=crm_secret_password
DB_NAME=business_crm
DB_PORT=5432
DB_HOST=localhost
DATABASE_URL="postgresql://crm_admin:crm_secret_password@localhost:5432/business_crm"

# Database SSL configuration (Enable in production for RDS / Supabase / Neon / Cloud SQL)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins for CORS
# CORS_ORIGIN=http://localhost:5173,https://crm.yourdomain.com

# ------------------------------------------------------------------------------
# Authentication & JWT Security Configuration
# ------------------------------------------------------------------------------
# In production, MUST be a cryptographically random string (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="super-secret-jwt-access-token-key-minimum-32-chars-long"
ACCESS_TOKEN_EXPIRES_IN="10m"
REFRESH_TOKEN_EXPIRES_IN="7d"
COOKIE_NAME="refreshToken"
COOKIE_SAME_SITE="lax"

# ------------------------------------------------------------------------------
# Production Docker Ports & Settings
# ------------------------------------------------------------------------------
WEB_PORT=80

# ------------------------------------------------------------------------------
# API Rate Limiting Configuration
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
