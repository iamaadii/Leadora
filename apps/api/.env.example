# ==============================================================================
# Leadora CRM — API Service Environment Configuration Template (apps/api/.env)
# ==============================================================================

# Application environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server port
PORT=5000

# Trusted Frontend client URL for CORS and cookie origin
FRONTEND_URL=http://localhost:5173

# Optional: Comma-separated list of allowed origins (e.g. for staging/preview domains)
# CORS_ORIGIN=http://localhost:5173,https://crm.yourdomain.com

# PostgreSQL Connection String
DATABASE_URL=postgresql://crm_admin:crm_secret_password@localhost:5432/business_crm

# Database SSL configuration (Enable in production for RDS / Supabase / Neon / Cloud SQL)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Authentication & JWT Configuration
# In production, MUST be a cryptographically random string (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=super-secret-jwt-access-token-key-minimum-32-chars-long
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_NAME=refreshToken
COOKIE_SAME_SITE=lax

# API Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10
